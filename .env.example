# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Generate DATA_KEY, INGEST_SECRET, DRILL_SECRET and the VAPID pair with: npm run keys

# Cloud Run: set by scripts/deploy-cloudrun.sh. LISTENER=1 runs the earthquake listener in-process.
LISTENER=0
# Browser origins allowed to call the API (the sunveda.tech copy of the pages)
ALLOWED_ORIGINS=https://sunveda.tech

# Public URL of this API deployment (used for unsubscribe links)
BASE_URL=https://daiboju.vercel.app
# Where people open the pages from message links. Pages are also hosted at sunveda.tech/app/daiboju
PUBLIC_URL=https://sunveda.tech/app/daiboju

# 32-byte base64 key. Encrypts every stored contact (email, phone, LINE id, push endpoint). Never rotate without migrating.
DATA_KEY=

# Shared secret the listener worker sends to /api/ingest
INGEST_SECRET=
# Secret typed into the /demo page to run drills
DRILL_SECRET=

# Storage: Upstash Redis (Vercel Marketplace → Upstash). If unset, an in-memory store is used (dev/tests only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini 4 Argon (Google AI Studio → Get API key). Not on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_THINKING_LEVEL=low
ARGON_TIMEOUT_MS=25000

# Set to 1 to log messages instead of sending them (safe default for local dev)
CHANNELS_DRY_RUN=1
# Launch gate: until 1, /api/subscribe accepts only drill opt-ins (open it once the privacy policy covers alert contacts)
SIGNUP_OPEN=0

# Web push (VAPID). Subject must be mailto: or https:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@sunveda.tech

# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=Daiboju <alerts@sunveda.tech>

# LINE Messaging API (official account)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Add-friend link of the official account, e.g. https://lin.ee/xxxx
LINE_ADD_URL=

# SMS and WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Minimum JMA seismic intensity (P2P scale: 30=3, 40=4, 45=5-, 50=5+, 55=6-, 60=6+, 70=7) that triggers alerts
MIN_QUAKE_SCALE=40
